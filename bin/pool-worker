#!/usr/bin/env php
<?php

// usage: pool-worker <autoload.php> <base_path>

use Voyager\Contracts\Console\Kernel;
use Voyager\Core\VenusianVoyager;
use Voyager\IOPools\PoolEnvelope;
use Voyager\IOPools\ProcessPoolFrame;

// stdout belongs to the protocol. Anything else, echoes and displayed errors alike, goes to stderr.
// First statement, so the autoloader's own warnings are caught too.
$closure = function (string $chunk) {
    fwrite(STDERR, $chunk); return '';
};
ob_start($closure, 1);

require $argv[1];

// launch() only builds the container. A gig reaching for app('hash') needs what the console boots.
// Bootstrap failures must not hit stdout: HandleExceptions renders to ConsoleOutput (the protocol pipe),
// and the parent then reports DeadWorkerException with an empty stderr tail.
try {
    VenusianVoyager::launch($argv[2])->make(Kernel::class)->bootstrap();
} catch (Throwable $e) {
    fwrite(STDERR, $e->getMessage().PHP_EOL);
    exit(1);
}

// booted: the parent holds our first gig until it reads this
ProcessPoolFrame::write(STDOUT, ['hello' => getmypid()]);

$buffer = '';

while (! feof(STDIN)) {
    $buffer .= fread(STDIN, 65536);                 // blocking read: a worker has nothing else to do

    while ($frame = ProcessPoolFrame::take($buffer)) {
        ProcessPoolFrame::write(STDOUT, PoolEnvelope::run($frame['job']));
    }
}
